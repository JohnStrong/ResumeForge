start: rule+

rule: selector "{" declaration+ "}"

selector: "layout"                              -> layout_selector
        | "heading"                             -> heading_selector
        | "section" "[" "name" "=" STRING "]"   -> section_selector
        | "@font-face"                          -> fontface_selector

declaration: PROPERTY ":" value ";"

value: VALUE+

PROPERTY: /[a-z][a-z\-]*/
VALUE: /[^\s;{}]+/
STRING: "\"" /[^"]*/ "\""

%ignore /\s+/
%ignore /\/\*[^*]*\*\//
