layout { mode: single; margins: 20mm 18mm 20mm 18mm; }

section[name="HEADER"] {
  font-size: 14pt;
  align: center;
  line-height: 7;
}

section[name="LINKS"] {
  font-size: 10pt;
  align: center;
  color: #336699;
  line-height: 6;
}

section[name="SKILLS"] {
  font-size: 10pt;
  line-height: 6;
}

section[name="WORK EXPERIENCE"] {
  font-size: 10pt;
  line-height: 6;
}

section[name="EDUCATION"] {
  font-size: 10pt;
  line-height: 6;
}

section[name="REFERENCES"] {
  font-size: 9pt;
  color: #666666;
  line-height: 5;
}
